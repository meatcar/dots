{
  "meta": {
    "name": "subagent",
    "description": "Generic headless agent base for agents nono has no pack for"
  },
  "extends": "default",
  // Deliberately thin: a language toolchain the agent turns out to need is one
  // `--extends {node,python,rust,go,java,bun}-dev` away at the call site.
  "groups": {
    "include": [
      "nix_runtime",
      "node_runtime",
      "git_config",
      "user_caches_linux",
      "linux_sysfs_read",
      "unlink_protection"
    ]
  },
  "workdir": {
    "access": "readwrite"
  }
}
