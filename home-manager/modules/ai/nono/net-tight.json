{
  "meta": {
    "name": "net-tight",
    "description": "Default-deny egress for headless agent runs; layer onto a pack profile with --extends"
  },
  "network": {
    // Any allow_domain flips nono into proxy mode, which is default-deny and
    // also drops direct localhost TCP -- so the cli-proxy-api ports have to be
    // named explicitly or every agent loses its LLM auth.
    "open_port": [8317, 80],
    "allow_domain": [
      "github.com",
      "raw.githubusercontent.com",
      "objects.githubusercontent.com",
      "registry.npmjs.org",
      "pypi.org",
      "files.pythonhosted.org",
      "crates.io",
      "static.crates.io",
      "cache.nixos.org"
    ]
  }
}
