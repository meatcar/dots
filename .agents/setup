#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nix_profile=/nix/var/nix/profiles/default

step() {
  printf '[setup +%ss] %s\n' "$SECONDS" "$1"
}

step "Checking Nix prerequisites"
missing_packages=()
command -v curl >/dev/null 2>&1 || missing_packages+=(curl)
command -v xz >/dev/null 2>&1 || missing_packages+=(xz-utils)
[ -r /etc/ssl/certs/ca-certificates.crt ] || missing_packages+=(ca-certificates)
if ((${#missing_packages[@]})); then
  time sudo apt-get update
  time sudo apt-get install -y "${missing_packages[@]}"
fi

if [ -x "$nix_profile/bin/nix" ]; then
  export PATH="$nix_profile/bin:$PATH"
fi

if [ -f "$nix_profile/etc/profile.d/nix-daemon.sh" ]; then
  # shellcheck disable=SC1091
  source "$nix_profile/etc/profile.d/nix-daemon.sh"
fi

if [ ! -x "$nix_profile/bin/nix" ]; then
  step "Installing Nix"
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT
  curl --fail --location --proto '=https' --tlsv1.2 \
    https://nixos.org/nix/install -o "$installer"
  time sh "$installer" --daemon --yes
  rm -f "$installer"
  trap - EXIT

  # The installer cannot update this running process's environment.
  # shellcheck disable=SC1091
  source "$nix_profile/etc/profile.d/nix-daemon.sh"
  export PATH="$nix_profile/bin:$PATH"
fi

if ! command -v nix >/dev/null 2>&1; then
  printf 'error: Nix was installed but is unavailable in this shell\n' >&2
  exit 1
fi

step "Enabling flakes"
mkdir -p "$HOME/.config/nix"
user_nix_config="$HOME/.config/nix/nix.conf"
feature_line="extra-experimental-features = nix-command flakes"
if ! grep -Fqx "$feature_line" "$user_nix_config" 2>/dev/null; then
  printf '\n%s\n' "$feature_line" >>"$user_nix_config"
fi

step "Enabling the flake's binary caches"
nix_config=/etc/nix/nix.conf
amp_nix_config=/etc/nix/amp-orb.conf
include_line="!include amp-orb.conf"
if sudo grep -Eq '^!?include[[:space:]]+(.*/)?nix\.custom\.conf([[:space:]]|$)' "$nix_config"; then
  include_config=/etc/nix/nix.custom.conf
else
  include_config="$nix_config"
fi
desired_nix_config="$(mktemp)"
trap 'rm -f "$desired_nix_config"' EXIT
printf '# Managed by dots/.agents/setup\nextra-trusted-users = %s\n' "$(id -un)" \
  >"$desired_nix_config"
nix_config_changed=false
if ! sudo cmp -s "$desired_nix_config" "$amp_nix_config"; then
  sudo install -m 0644 "$desired_nix_config" "$amp_nix_config"
  nix_config_changed=true
fi
if ! sudo grep -Eq '^!?include[[:space:]]+(.*/)?amp-orb\.conf([[:space:]]|$)' "$include_config"; then
  printf '\n%s\n' "$include_line" | sudo tee -a "$include_config" >/dev/null
  nix_config_changed=true
fi
rm -f "$desired_nix_config"
trap - EXIT
if $nix_config_changed; then
  sudo systemctl restart nix-daemon.service
fi
if ! nix store info --json | grep -Fq '"trusted":true'; then
  printf 'error: Nix daemon does not trust user %s\n' "$(id -un)" >&2
  exit 1
fi

step "Configuring login shells"
profile_fragment="$HOME/.config/amp/dots-dev-shell.bash"
mkdir -p "$(dirname "$profile_fragment")"
profile_fragment_tmp="$(mktemp)"
trap 'rm -f "$profile_fragment_tmp"' EXIT
cat >"$profile_fragment_tmp" <<EOF
# Generated by dots/.agents/setup.
case "\$PWD" in
  "$repo_root"|"$repo_root"/*)
    if [[ -z "\${IN_NIX_SHELL:-}" ]]; then
      original_pwd="\$PWD"
      if cd "$repo_root" && nix_env="\$("$nix_profile/bin/nix" print-dev-env --accept-flake-config --no-update-lock-file "$repo_root")"; then
        if ! eval "\$nix_env"; then
          printf 'error: failed to activate the dots Nix development shell\n' >&2
          cd "\$original_pwd"
          return 1
        fi
        unset nix_env
        cd "\$original_pwd"
        unset original_pwd
        export PATH="$nix_profile/bin:\${PATH}"
      else
        printf 'error: failed to load the dots Nix development shell\n' >&2
        cd "\$original_pwd"
        return 1
      fi
    fi
    ;;
esac
EOF
mv "$profile_fragment_tmp" "$profile_fragment"
trap - EXIT

# Remove the profile block written by older versions of this script.
if grep -Fqx '# dots Nix development shell' "$HOME/.bash_profile" 2>/dev/null; then
  sed -i '/^# dots Nix development shell$/,/^fi$/d' "$HOME/.bash_profile"
fi
profile_source="[ ! -f \"$profile_fragment\" ] || . \"$profile_fragment\""
if ! grep -Fqx "$profile_source" "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n%s\n' "$profile_source" >>"$HOME/.bash_profile"
fi

step "Preparing the locked development shell"
time nix build --accept-flake-config --no-link --no-update-lock-file \
  "$repo_root#devShells.x86_64-linux.default"

step "Setup complete"
